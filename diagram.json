{
  "version": 1,
  "author": "Automatic Agricultural Dryer",
  "editor": "wokwi",

  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": -50,
      "left": 0,
      "attrs": {}
    },

    {
      "type": "wokwi-potentiometer",
      "id": "rainSensor",
      "top": -120,
      "left": -300,
      "attrs": {
        "value": "500"
      }
    },

    {
      "type": "wokwi-dht22",
      "id": "dht",
      "top": 100,
      "left": -300,
      "attrs": {
        "temperature": "30",
        "humidity": "70"
      }
    },

    {
      "type": "wokwi-photoresistor-sensor",
      "id": "photo",
      "top": 300,
      "left": -300,
      "attrs": {
        "lux": "500"
      }
    },

    {
      "type": "wokwi-pushbutton",
      "id": "limitOpen",
      "top": 100,
      "left": 300,
      "attrs": {
        "color": "green",
        "label": "LIMIT OPEN",
        "bounce": "0"
      }
    },

    {
      "type": "wokwi-pushbutton",
      "id": "limitClose",
      "top": 220,
      "left": 300,
      "attrs": {
        "color": "red",
        "label": "LIMIT CLOSE",
        "bounce": "0"
      }
    },

    {
      "type": "wokwi-led",
      "id": "statusLed",
      "top": 350,
      "left": 300,
      "attrs": {
        "color": "red",
        "label": "STATUS"
      }
    },

    {
      "type": "wokwi-resistor",
      "id": "ledResistor",
      "top": 350,
      "left": 400,
      "attrs": {
        "value": "1000"
      }
    }
  ],

  "connections": [

    ["esp:TX", "$serialMonitor:RX", "", []],
    ["esp:RX", "$serialMonitor:TX", "", []],

    ["rainSensor:VCC", "esp:3V3", "red", []],
    ["rainSensor:GND", "esp:GND.1", "black", []],
    ["rainSensor:SIG", "esp:D34", "green", []],

    ["dht:VCC", "esp:3V3", "red", []],
    ["dht:SDA", "esp:D4", "blue", []],
    ["dht:GND", "esp:GND.1", "black", []],

    ["photo:VCC", "esp:3V3", "red", []],
    ["photo:GND", "esp:GND.1", "black", []],
    ["photo:AO", "esp:D35", "yellow", []],

    ["limitOpen:1.l", "esp:D18", "green", []],
    ["limitOpen:2.l", "esp:GND.1", "black", []],

    ["limitClose:1.l", "esp:D19", "green", []],
    ["limitClose:2.l", "esp:GND.1", "black", []],

    ["statusLed:A", "ledResistor:1", "red", []],
    ["ledResistor:2", "esp:23", "green", []],
    ["statusLed:C", "esp:GND.1", "black", []]
  ],

  "serialMonitor": {
    "display": "terminal",
    "convertEol": true
  },

  "dependencies": {}
}
